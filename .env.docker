# LOCAL docker-compose env only. NOT used by Render (Render env lives in
# render.yaml + the Render dashboard). Safe to commit: no real secrets,
# this APP_KEY and DB password are throwaway local values.

APP_NAME=Laboratory
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:LhqUrlq2SWL6ZCG5niruFrsn/Exqgjf7/kZfI3rFE90=
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Local Postgres from the "db" service (service name = hostname)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laboratory
DB_USERNAME=laboratory
DB_PASSWORD=secret
DB_SSLMODE=disable

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

